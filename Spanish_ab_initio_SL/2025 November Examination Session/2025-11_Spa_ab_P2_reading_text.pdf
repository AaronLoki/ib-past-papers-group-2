   <dc:subject>
    <rdf:Bag>
     <rdf:li>espeletia</rdf:li>
     <rdf:li>frailejon</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">MERIDA, VENEZUELA, SEP 12 2017: Espeletia, also named Frailejon in Venezuela, is an autochthonous plant from the Andes which grow at high altitude only.</rdf:li>
    </rdf:Alt>
   </dc:description>
